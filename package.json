{
  "name": "jira-planning-poker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:ui && forge deploy --verbose",
    "build:ui": "npm --prefix static/planning-poker-ui run build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "npm run lint && npm run typecheck && npm run test:backend && npm run test:frontend",
    "test:backend": "vitest run",
    "test:frontend": "npm --prefix static/planning-poker-ui run test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alptalhayazar/planning-poker-relay-events": "^0.1.5",
    "@forge/api": "^6.2.0",
    "@forge/resolver": "^1.7.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.10"
  }
}
